{
  "name": "narration-app",
  "version": "1.0.0",
  "description": "Full-stack AI Narration Web Application powered by ElevenLabs API",
  "scripts": {
    "install-all": "npm install && npm --prefix backend install && npm --prefix frontend install",
    "live": "concurrently -n \"BACKEND,FRONTEND\" -c \"cyan,magenta\" \"npm run start-backend\" \"npm run start-frontend\"",
    "start-backend": "cd backend && node server.js",
    "start-frontend": "cd frontend && npx vite",
    "build": "cd frontend && npx vite build",
    "start": "npm run start-backend",
    "dev": "npm run live"
  },
  "keywords": [
    "elevenlabs",
    "text-to-speech",
    "narration",
    "ai-voice",
    "react",
    "express"
  ],
  "author": "Prateek Sharma",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.8.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
