{
  "name": "elevenlabsapigiriraj",
  "version": "1.0.0",
  "description": "Full-stack AI Narration Web Application powered by ElevenLabs API",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "server": "node server/server.js",
    "client": "cd client && npx vite",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"cyan,magenta\" \"node server/server.js\" \"cd client && npx vite\"",
    "build": "cd client && npx vite build"
  },
  "keywords": [
    "elevenlabs",
    "text-to-speech",
    "ai-narration",
    "audio-synthesis",
    "voice-generator"
  ],
  "author": "Prateek Sharma",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.8.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
